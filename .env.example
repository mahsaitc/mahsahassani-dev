# Public site URL — used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://mahsahassani.dev

# Contact form (server build only). Get a key at https://resend.com
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
CONTACT_FROM="Portfolio <hello@mahsahassani.dev>"
CONTACT_TO=mahsaitc74@gmail.com

# Optional. Raises the GitHub API limit from 60/hr to 5000/hr for repo stats.
# A classic token with no scopes is enough — it only reads public repos.
GITHUB_TOKEN=

# ── Content API (see ADMIN.md) ───────────────────────────────────────────────
# Where the ASP.NET backend is reachable from the Next.js server.
API_BASE_URL=http://localhost:5099

# Same address, but used in the browser for <img>/<video> src on uploads.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5099

# Seconds before a cached public page is refreshed from the API.
API_REVALIDATE_SECONDS=60
