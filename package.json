{
  "name": "mahsahassani-dev",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Mahsa Hassani — Computer Engineer, Software Design.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "echo \"Static export is unavailable while the admin panel is present - see README (Deployment). Use: npm run build\" && exit 1",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/generate-og.mjs",
    "resume": "node --import ./scripts/ts-alias-hook.mjs scripts/generate-resume.mjs",
    "api": "dotnet run --project backend/src/MahsaSite.Api",
    "api:migrate": "dotnet ef database update -p backend/src/MahsaSite.Infrastructure -s backend/src/MahsaSite.Api",
    "import:content": "node --import ./scripts/ts-alias-hook.mjs scripts/import-existing-content.mjs",
    "seed:settings": "node scripts/seed-settings.mjs",
    "build:isolated": "cross-env NEXT_DIST_DIR=.next-build next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20.17.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "pdfkit": "^0.20.2",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
