# Backend configuration. Copy to .env and fill in before first run.
# Every value here is a secret or environment-specific — none are committed.

# At least 32 characters. Generate with:
#   openssl rand -base64 48
Jwt__SigningKey=

# First admin, created on startup only while the user table is empty.
# Delete these two lines once the account exists.
SeedAdmin__Email=
SeedAdmin__Password=

# Where the public site runs, for CORS.
Cors__AllowedOrigins__0=http://localhost:3000

ConnectionStrings__Default=Data Source=mahsasite.db
Storage__RootPath=uploads
